# Salin menjadi .env lalu sesuaikan
PORT=3000
HOST=0.0.0.0

# Identitas toko
STORE_NAME=Ayam Kriuk Jaya
STORE_ADDRESS=Jl. Raden Intan No. 10, Bandar Lampung
STORE_LAT=-5.4295
STORE_LNG=105.2610
STORE_WA=6281234567890

# WAJIB diganti di produksi
ADMIN_PASSWORD=ganti-password-admin
# Boleh dikosongkan (otomatis dibuat & disimpan di data/db.json)
SECRET=

# Ongkir: tarif dasar sampai BASE_KM, lalu per km, jangkauan maksimal
DELIVERY_BASE_FEE=5000
DELIVERY_BASE_KM=2
DELIVERY_PER_KM=2500
MAX_KM=12
PACKAGING_FEE=1500

# Pembayaran: demo = tombol "simulasikan bayar" aktif (untuk uji coba).
# Untuk produksi isi gateway sungguhan (lihat lib/payment.js) dan set PAYMENT_MODE=live
PAYMENT_MODE=demo
PAYMENT_WEBHOOK_SECRET=
ENABLE_COD=1

# Kurir: demo | manual (admin isi nama driver sendiri). Adapter Lalamove/Grab/Gojek: lib/courier.js
COURIER_PROVIDER=demo

# 1 = pesanan maju otomatis tiap beberapa detik (hanya untuk demo)
AUTOPILOT=0

# Isi 1 jika di belakang Nginx/Cloudflare agar IP pengunjung terbaca benar
TRUST_PROXY=0
DATA_FILE=./data/db.json
